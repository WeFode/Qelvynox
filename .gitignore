.DS_Store
Thumbs.db
Desktop.ini
*.log
.vscode/
.idea/
node_modules/

# ---- Chrome unpacked-extension leftovers ----
_metadata/

# ---- Build output: the store upload archive is generated by `node dev/package.mjs` ----
*.zip

# ---- Local-only working areas ----
backups/
scratch/
dev/.chrome-profile/

# ---- Developer scratch: a scan dump of user-visible wording pulled out of the source ----
chinese-lines.txt

# ---- Local marketing artwork kept off the public repo ----
# The root poster has a Chinese file name, is 1.6 MB and still advertises the retired
# folder feature plus an old version badge. README uses the compressed copy in assets/.
/Qelvynox宣传海报.png
assets/*.png

# ---- Screenshots: only the ones the READMEs embed are published ----
# `screenshots/*` (not `screenshots/`) so the negation below can still match files:
# git never re-includes a file whose containing directory is excluded.
screenshots/*
!screenshots/release-*.png
